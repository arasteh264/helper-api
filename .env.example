JWT_EXPIRES_IN=1d

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
# Use the Cloudinary API host for your account's region (e.g. api.cloudinary.com or api-eu.cloudinary.com).
CLOUDINARY_UPLOAD_PREFIX=https://api.cloudinary.com

ZARINPAL_MERCHANT_ID=YOUR_ZARINPAL_MERCHANT_ID
ZARINPAL_SANDBOX=true

ZARINPAL_CALLBACK_URL=https://YOUR_PUBLIC_API_URL/payments/zarinpal/callback

PAYMENT_RETURN_URL=http://localhost:3000/payment/result


SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD

# Set true to require OTP for customer registration (disabled by default).
REQUIRE_REGISTRATION_OTP=false

# Public customer-facing provider onboarding form used in SMS invitations.
PROVIDER_ONBOARDING_URL=http://localhost:3000/provider/onboarding
CUSTOMER_APP_URL=http://localhost:3000