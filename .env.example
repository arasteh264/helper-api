JWT_EXPIRES_IN=1d

ZARINPAL_MERCHANT_ID=YOUR_ZARINPAL_MERCHANT_ID
ZARINPAL_SANDBOX=true

ZARINPAL_CALLBACK_URL=https://YOUR_PUBLIC_API_URL/payments/zarinpal/callback

PAYMENT_RETURN_URL=http://localhost:3000/payment/result

KAVENEGAR_API_KEY=YOUR_KAVENEGAR_API_KEY
KAVENEGAR_SENDER=YOUR_KAVENEGAR_SENDER

SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD

# Required for OTP; optional specialty caching. Configure in deployment secrets.
REDIS_URL=
REDIS_KEY_PREFIX=helper-api:
SPECIALTY_CACHE_TTL_SECONDS=60
