generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerAddressType {
  HOME
  WORK
  OTHER
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum ProviderArticleStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
}

enum NotificationCategory {
  MESSAGES
  WORK_UPDATES
  OPPORTUNITIES
  PAYMENTS
  PROMOTIONS
}

enum NotificationType {
  CHAT_MESSAGE
  SERVICE_REQUEST_STATUS
  PROVIDER_OFFER
  NEW_OPPORTUNITY
  PAYMENT_UPDATE
}

enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProviderAddressType {
  HOME
  BUSINESS
}

enum ProviderDocumentType {
  NATIONAL_CARD
  BUSINESS_LICENSE
  CERTIFICATE
  COMMITMENT_LETTER
  CRIMINAL_RECORD
  OTHER
}

enum ProviderStoryMediaType {
  IMAGE
  VIDEO
}

enum ProviderStoryStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ProviderStoryMonetizationStatus {
  FREE
  PENDING_ADMIN_SETUP
  PAYMENT_REQUIRED
  PAID
}

enum ProviderStoryApprovalAction {
  APPROVE
  REJECT
  FLAG
  SET_PRICING
}

enum ProviderReferralRewardType {
  STORY_PUBLISHING
  ARTICLE_PUBLISHING
  ZERO_COMMISSION
}

model User {
  id                            String                         @id @default(uuid())
  name                          String
  email                         String                         @unique
  phone                         String                         @unique
  passwordHash                  String?
  role                          UserRole
  status                        UserStatus
  resetToken                    String?
  resetTokenExpiry              DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  otpCode                       String?
  otpExpiresAt                  DateTime?
  providerProfile               ProviderProfile?
  customerProfile               CustomerProfile?
  serviceRequests               ServiceRequest[]               @relation("CustomerServiceRequests")
  addresses                     CustomerAddress[]
  reviewsGiven                  ServiceRequestReview[]         @relation("CustomerReviews")
  sentChatMessages              ChatMessage[]                  @relation("ChatMessageSender")
  moderatedChatMessages         ChatMessage[]                  @relation("ChatMessageModerator")
  providerStoryConversations    ProviderStoryConversation[]    @relation("ProviderStoryCustomer")
  providerStoryMessages         ProviderStoryMessage[]        @relation("ProviderStoryMessageSender")
  notificationPreference        NotificationPreference?
  notifications                 Notification[]
  disputeMessages               ServiceRequestDisputeMessage[]
  providerOnboardingInvitations ProviderOnboardingInvitation[] @relation("ProviderOnboardingInvitationCreator")
  adminActions                  AdminAuditLog[]                @relation("AdminAuditActor")
  storiesReviewed               ProviderStory[]
  storyApprovalLogs             ProviderStoryApprovalLog[]     @relation("ProviderStoryApprovalLogs")
  storyPaymentApprovals         ProviderStoryPayment[]         @relation("ProviderStoryPaymentApprovals")
  storyPayments                 ProviderStoryPayment[]         @relation("ProviderStoryPayments")
  articleRatings                ProviderArticleRating[]
  articlesReviewed              ProviderArticle[]              @relation("ProviderArticleReviewer")
  invoices                      Invoice[]
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  reason      String   @db.Text
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now())

  actor User @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model ProviderOnboardingInvitation {
  id              String    @id @default(uuid())
  phone           String
  candidateName   String?
  specialty       String?
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  smsSentAt       DateTime?
  createdAt       DateTime  @default(now())
  createdById     String

  createdBy User @relation("ProviderOnboardingInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([phone, createdAt])
  @@index([expiresAt, usedAt, revokedAt])
}

model BlogPost {
  id             String         @id @default(uuid())
  slug           String         @unique
  title          String
  excerpt        String         @db.VarChar(320)
  category       String
  categorySlug   String
  authorName     String
  authorRole     String
  content        Json
  coverImage     String?
  coverAlt       String?
  coverTint      String         @default("from-emerald-500/25 via-emerald-500/10 to-transparent")
  readingMinutes Int            @default(1)
  seoTitle       String?
  seoDescription String?        @db.VarChar(320)
  canonicalUrl   String?
  tags           String[]       @default([])
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt(sort: Desc), id])
  @@index([categorySlug, status, publishedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

model ProviderArticle {
  id                String               @id @default(uuid())
  providerProfileId String
  slug              String               @unique
  title             String
  excerpt           String               @db.VarChar(320)
  content           Json
  coverImage        String?
  coverPublicId     String?
  coverAlt          String?
  readingMinutes    Int                  @default(1)
  status            ProviderArticleStatus @default(PENDING_REVIEW)
  reviewNote        String?              @db.Text
  reviewedById      String?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  providerProfile ProviderProfile          @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  reviewedBy      User?                    @relation("ProviderArticleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  categories      ProviderArticleCategory[]
  specialties     ProviderArticleSpecialty[]
  ratings         ProviderArticleRating[]

  @@index([status, publishedAt(sort: Desc), id])
  @@index([providerProfileId, updatedAt(sort: Desc)])
}

model ProviderArticleCategory {
  articleId       String
  specialtyGroupId String

  article       ProviderArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  specialtyGroup SpecialtyGroup @relation(fields: [specialtyGroupId], references: [id], onDelete: Cascade)

  @@id([articleId, specialtyGroupId])
  @@index([specialtyGroupId])
}

model ProviderArticleSpecialty {
  articleId   String
  specialtyId String

  article   ProviderArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  specialty Specialty      @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([articleId, specialtyId])
  @@index([specialtyId])
}

model ProviderArticleRating {
  id        String   @id @default(uuid())
  articleId String
  userId    String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article ProviderArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId, createdAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  messagesInApp      Boolean  @default(true)
  messagesSms        Boolean  @default(false)
  messagesEmail      Boolean  @default(false)
  workUpdatesInApp   Boolean  @default(true)
  workUpdatesSms     Boolean  @default(false)
  workUpdatesEmail   Boolean  @default(false)
  opportunitiesInApp Boolean  @default(true)
  opportunitiesSms   Boolean  @default(false)
  opportunitiesEmail Boolean  @default(false)
  paymentsInApp      Boolean  @default(true)
  paymentsSms        Boolean  @default(false)
  paymentsEmail      Boolean  @default(false)
  promotionsInApp    Boolean  @default(false)
  promotionsSms      Boolean  @default(false)
  promotionsEmail    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String               @id @default(uuid())
  userId           String
  category         NotificationCategory
  type             NotificationType
  title            String
  body             String               @db.Text
  serviceRequestId String?
  invoiceId        String?
  chatMessageId    String?
  createdAt        DateTime             @default(now())
  readAt           DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessage ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([userId, readAt])
  @@index([chatMessageId])
  @@index([invoiceId])
}

model PendingRegistration {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  otpCode      String
  otpExpiresAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProviderProfile {
  id                   String                     @id @default(uuid())
  userId               String                     @unique
  bio                  String?
  rating               Float                      @default(0)
  isVerified           Boolean                    @default(false)
  verificationStatus   ProviderVerificationStatus @default(PENDING)
  verificationNote     String?
  verifiedAt           DateTime?
  isAvailable          Boolean                    @default(false)
  serviceAreaLatitude  Float?
  serviceAreaLongitude Float?
  serviceAreaRadiusKm  Float                      @default(10)
  providerAddress      String?                    @db.Text
  providerAddressType  ProviderAddressType        @default(HOME)
  avatarUrl            String?
  avatarPublicId       String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  user                    User                        @relation(fields: [userId], references: [id])
  skills                  ProviderSkill[]
  specialties             ProviderSpecialty[]
  documents               ProviderDocument[]
  portfolioItems          PortfolioItem[]
  acceptedServiceRequests ServiceRequest[]            @relation("AcceptedServiceRequests")
  quotes                  ServiceRequestQuote[]
  requestDeclines         ProviderRequestDecline[]
  requestInvitations      ProviderRequestInvitation[]
  wallet                  Wallet?
  bankAccount             ProviderBankAccount?
  reviews                 ServiceRequestReview[]      @relation("ProviderReviews")
  stories                 ProviderStory[]
  storyConversations      ProviderStoryConversation[]
  storyPayments           ProviderStoryPayment[]      @relation("ProviderStoryProfilePayments")
  articles                ProviderArticle[]
  invoices                Invoice[]
  workReports             ServiceWorkReport[]
  canPublishStories       Boolean                     @default(false)
  canViewStoryStats       Boolean                     @default(false)
  canPublishArticles      Boolean                     @default(false)
  commissionExempt        Boolean                     @default(false)
  referralCode            ProviderReferralCode?
  referralReceived        ProviderReferral?           @relation("ProviderReferralInvitee")
}

model ProviderReferralCode {
  id                String   @id @default(uuid())
  providerProfileId String   @unique
  code              String   @unique
  createdAt         DateTime @default(now())

  providerProfile ProviderProfile   @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  referrals       ProviderReferral[]
}

model ProviderReferral {
  id                       String                      @id @default(uuid())
  referralCodeId           String
  referredProviderProfileId String                      @unique
  rewardType               ProviderReferralRewardType?
  rewardedAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  referralCode           ProviderReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referredProviderProfile ProviderProfile      @relation("ProviderReferralInvitee", fields: [referredProviderProfileId], references: [id], onDelete: Cascade)

  @@index([referralCodeId, createdAt])
  @@index([rewardType, rewardedAt])
}

model SpecialtyGroup {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  icon         String?
  iconPublicId String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  specialties Specialty[]
  articleLinks ProviderArticleCategory[]

  @@index([sortOrder])
}

model Specialty {
  id               String               @id @default(uuid())
  groupId          String
  name             String
  slug             String               @unique
  icon             String?
  iconPublicId     String?
  pricingMode      SpecialtyPricingMode @default(QUOTE)
  hourlyRateToman  Int?
  hourlyUnitLabel  String?
  allowsQuoteItems Boolean              @default(false)
  sortOrder        Int                  @default(0)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  group           SpecialtyGroup      @relation(fields: [groupId], references: [id])
  providers       ProviderSpecialty[]
  serviceRequests ServiceRequest[]
  providerStories ProviderStory[]
  articleLinks    ProviderArticleSpecialty[]

  @@index([groupId, sortOrder])
}

enum SpecialtyPricingMode {
  QUOTE
  HOURLY
}

model ProviderSpecialty {
  providerProfileId String
  specialtyId       String
  createdAt         DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  specialty       Specialty       @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([providerProfileId, specialtyId])
  @@index([specialtyId])
}

enum ProviderDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProviderDocument {
  id                String                 @id @default(uuid())
  providerProfileId String
  type              ProviderDocumentType
  url               String
  publicId          String?
  status            ProviderDocumentStatus @default(PENDING)
  rejectionNote     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id])

  @@unique([providerProfileId, type])
  @@index([providerProfileId, createdAt])
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  providers       ProviderSkill[]
  serviceRequests ServiceRequestSkill[]
}

model ProviderSkill {
  providerProfileId String
  skillId           String

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id])
  skill           Skill           @relation(fields: [skillId], references: [id])

  @@id([providerProfileId, skillId])
}

enum ServiceRequestStatus {
  PENDING_ADMIN_REVIEW
  OPEN
  OFFER_ACCEPTED
  CUSTOMER_CONFIRMATION_PENDING
  IN_PROGRESS
  AWAITING_CUSTOMER_CONFIRMATION
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum PreferredTime {
  URGENT
  THIS_WEEK
  FLEXIBLE
}

enum DisputeResolution {
  PROVIDER
  BUYER
}

enum DisputeReason {
  WORK_NOT_COMPLETED
  WORK_QUALITY
  PRICE_DISAGREEMENT
  PROVIDER_NO_SHOW
  CUSTOMER_NON_PAYMENT
  OTHER
}

model ServiceRequest {
  id                           String                @id @default(uuid())
  customerId                   String
  acceptedProviderProfileId    String?
  specialtyId                  String?
  providerPriceToman           Int?
  providerLaborPriceToman      Int?
  providerQuoteNote            String?               @db.Text
  providerQuoteItems           Json                  @default("[]")
  providerPricingMode          SpecialtyPricingMode?
  providerHourlyRateToman      Int?
  providerHourlyUnitLabel      String?
  providerEstimatedHours       Float?
  title                        String
  description                  String
  status                       ServiceRequestStatus  @default(OPEN)
  customerConfirmationDeadline DateTime?
  disputeResolution            DisputeResolution?
  disputeResolutionNote        String?               @db.Text
  disputeResolvedById          String?
  disputeResolvedAt            DateTime?
  disputeReason                DisputeReason?
  disputeDescription           String?               @db.Text
  disputeUpdatedAt             DateTime?
  adminReviewNote              String?               @db.Text

  address   String?
  latitude  Float?
  longitude Float?

  budgetMin     Float?
  budgetMax     Float?
  preferredTime PreferredTime?
  scheduledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills                  ServiceRequestSkill[]
  specialty               Specialty?                     @relation(fields: [specialtyId], references: [id])
  quotes                  ServiceRequestQuote[]
  images                  ServiceRequestImage[]
  acceptedProviderProfile ProviderProfile?               @relation("AcceptedServiceRequests", fields: [acceptedProviderProfileId], references: [id])
  customer                User                           @relation("CustomerServiceRequests", fields: [customerId], references: [id], onDelete: Cascade)
  providerDeclines        ProviderRequestDecline[]
  invitations             ProviderRequestInvitation[]
  payments                Payment[]
  review                  ServiceRequestReview?
  chatConversation        ChatConversation?
  disputeMessages         ServiceRequestDisputeMessage[]
  invoice                 Invoice?
  workReport              ServiceWorkReport?

  @@index([acceptedProviderProfileId, status])
  @@index([specialtyId, status])
  @@index([customerId, status, createdAt, id])
}

model Invoice {
  id                String        @id @default(uuid())
  serviceRequestId  String        @unique
  customerId        String
  providerProfileId String
  items             Json
  totalToman        Int
  status            InvoiceStatus @default(DRAFT)
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  customer        User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@index([customerId, status, createdAt(sort: Desc)])
  @@index([providerProfileId, createdAt(sort: Desc)])
}

model ServiceWorkReport {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique
  providerProfileId String
  summary          String   @db.Text
  materials        Json     @default("[]")
  warrantyDays     Int?
  warrantyNote     String?  @db.Text
  completedAt      DateTime @default(now())
  warrantyExpiresAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, completedAt(sort: Desc)])
  @@index([warrantyExpiresAt])
}

model ServiceRequestQuote {
  id                String               @id @default(uuid())
  serviceRequestId  String
  providerProfileId String
  laborPriceToman   Int
  totalPriceToman   Int
  quoteNote         String               @db.Text
  estimatedHours    Float?
  pricingMode       SpecialtyPricingMode
  hourlyRateToman   Int?
  hourlyUnitLabel   String?
  items             Json                 @default("[]")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, providerProfileId])
  @@index([serviceRequestId, createdAt])
}

model ServiceRequestDisputeMessage {
  id               String         @id @default(uuid())
  serviceRequestId String
  authorUserId     String
  body             String         @db.Text
  createdAt        DateTime       @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  author           User           @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, createdAt])
  @@index([authorUserId, createdAt])
}

model ServiceRequestReview {
  id                String   @id @default(uuid())
  serviceRequestId  String   @unique
  customerId        String
  providerProfileId String
  rating            Int
  text              String?  @db.Text
  createdAt         DateTime @default(now())

  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  customer        User            @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile @relation("ProviderReviews", fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, createdAt])
  @@index([customerId, createdAt])
}

enum ChatConversationStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum ChatMessageStatus {
  VISIBLE
  HIDDEN
}

model ChatConversation {
  id               String                 @id @default(uuid())
  serviceRequestId String                 @unique
  status           ChatConversationStatus @default(ACTIVE)
  pausedReason     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@index([status, updatedAt])
}

model ChatMessage {
  id             String            @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String            @db.Text
  status         ChatMessageStatus @default(VISIBLE)
  moderatedById  String?
  moderationNote String?
  moderatedAt    DateTime?
  createdAt      DateTime          @default(now())

  conversation  ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User             @relation("ChatMessageSender", fields: [senderUserId], references: [id])
  moderatedBy   User?            @relation("ChatMessageModerator", fields: [moderatedById], references: [id])
  notifications Notification[]

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  ZARINPAL
  WALLET
}

model Payment {
  id                        String         @id @default(uuid())
  serviceRequestId          String
  amountToman               Int
  gateway                   PaymentGateway @default(ZARINPAL)
  status                    PaymentStatus  @default(PENDING)
  authority                 String?        @unique
  referenceId               String?
  failureReason             String?
  paidAt                    DateTime?
  lastVerificationAttemptAt DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([serviceRequestId, createdAt])
}

model ProviderRequestDecline {
  providerProfileId String
  serviceRequestId  String
  createdAt         DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@id([providerProfileId, serviceRequestId])
  @@index([serviceRequestId])
}

model ServiceRequestSkill {
  serviceRequestId String
  skillId          String

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  skill          Skill          @relation(fields: [skillId], references: [id])

  @@id([serviceRequestId, skillId])
}

model ServiceRequestImage {
  id               String   @id @default(uuid())
  serviceRequestId String
  url              String
  publicId         String
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
}

enum WalletTransactionType {
  EARNING // واریز بابت کار انجام‌شده
  COMMISSION // کارمزد کسرشده توسط پلتفرم
  PAYOUT_REQUEST // کسر موجودی بابت درخواست برداشت
  PAYOUT_REFUND // برگشت پول درخواست رد یا لغو شده
  ADJUSTMENT // اصلاح دستی توسط ادمین
  STORY_PROMOTION // هزینه‌ی انتشار استوری
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
}

model Wallet {
  id                String   @id @default(uuid())
  providerProfileId String   @unique
  balance           Int      @default(0) // موجودی قابل برداشت
  totalEarned       Int      @default(0)
  totalWithdrawn    Int      @default(0) // مجموع برداشت‌های PAID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  providerProfile ProviderProfile     @relation(fields: [providerProfileId], references: [id])
  transactions    WalletTransaction[]
  payouts         PayoutRequest[]
}

model WalletTransaction {
  id               String                @id @default(uuid())
  walletId         String
  type             WalletTransactionType
  amount           Int // مثبت = واریز، منفی = برداشت
  balanceAfter     Int
  description      String?
  serviceRequestId String?
  payoutRequestId  String?
  createdAt        DateTime              @default(now())

  wallet               Wallet                @relation(fields: [walletId], references: [id])
  providerStoryPayment ProviderStoryPayment?

  // جلوگیری از واریز دوباره برای یک کار (NULLها در Postgres با هم تداخل ندارن)
  @@unique([walletId, type, serviceRequestId])
  @@index([walletId, createdAt])
}

model ProviderBankAccount {
  id                String   @id @default(uuid())
  providerProfileId String   @unique
  holderName        String
  sheba             String
  bankName          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id])
}

model PayoutRequest {
  id       String       @id @default(uuid())
  walletId String
  amount   Int
  status   PayoutStatus @default(PENDING)

  // کپی حساب بانکی در لحظه درخواست، تا تغییر بعدی حساب روی درخواست‌های قدیمی اثر نذاره
  holderName String
  sheba      String
  bankName   String?

  referenceCode String? // کد پیگیری واریز (توسط ادمین)
  rejectReason  String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([status, createdAt])
}

model PortfolioItem {
  id                String   @id @default(uuid())
  providerProfileId String
  title             String?
  description       String?
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  providerProfile ProviderProfile      @relation(fields: [providerProfileId], references: [id])
  images          PortfolioItemImage[]

  @@index([providerProfileId, order])
}

model PortfolioItemImage {
  id              String   @id @default(uuid())
  portfolioItemId String
  url             String
  publicId        String
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@index([portfolioItemId, order])
}

model WalletConfiguration {
  id                          String   @id @default("global")
  commissionRate              Float    @default(10)
  minWithdrawal               Int      @default(100000)
  requireServiceRequestReview Boolean  @default(true)
  storyVideoMaxSizeMB         Int      @default(100)
  updatedAt                   DateTime @updatedAt
}

enum ProviderInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model ProviderRequestInvitation {
  id                String                   @id @default(uuid())
  providerProfileId String
  serviceRequestId  String
  status            ProviderInvitationStatus @default(PENDING)
  declineReason     String?
  declineNote       String?
  createdAt         DateTime                 @default(now())
  respondedAt       DateTime?
  distanceKm        Float?
  notifiedAt        DateTime?
  providerProfile   ProviderProfile          @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  serviceRequest    ServiceRequest           @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@unique([providerProfileId, serviceRequestId])
  @@index([providerProfileId, status, createdAt])
  @@index([serviceRequestId, status])
}

model CustomerWallet {
  id                String   @id @default(uuid())
  customerProfileId String   @unique
  balance           Int      @default(0)
  totalSpent        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile CustomerProfile       @relation(fields: [customerProfileId], references: [id])
  topups          CustomerWalletTopup[]
}

model CustomerWalletTopup {
  id                        String         @id @default(uuid())
  customerWalletId          String
  amountToman               Int
  gateway                   PaymentGateway @default(ZARINPAL)
  status                    PaymentStatus  @default(PENDING)
  authority                 String?        @unique
  referenceId               String?
  failureReason             String?
  paidAt                    DateTime?
  lastVerificationAttemptAt DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  customerWallet CustomerWallet @relation(fields: [customerWalletId], references: [id], onDelete: Cascade)

  @@index([customerWalletId, createdAt])
  @@index([status, createdAt])
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id])
  wallet CustomerWallet?
}

model CustomerAddress {
  id            String              @id @default(uuid())
  customerId    String
  title         String
  type          CustomerAddressType @default(HOME)
  receiverName  String
  receiverPhone String
  city          String
  fullAddress   String
  plaque        String
  unit          String              @default("")
  postalCode    String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault, createdAt])
}

model ProviderStory {
  id                 String                          @id @default(uuid())
  providerProfileId  String
  title              String
  description        String?                         @db.Text
  specialtyId        String?
  overlayText        String?                         @db.VarChar(120)
  overlayColor       String                          @default("#ffffff")
  overlayFontSize    Int                             @default(28)
  overlayPositionX   Float                           @default(50)
  overlayPositionY   Float                           @default(50)
  mediaType          ProviderStoryMediaType
  mediaUrl           String
  mediaPublicId      String?
  thumbnailUrl       String?
  thumbnailPublicId  String?
  durationSeconds    Int?
  status             ProviderStoryStatus             @default(DRAFT)
  isPaid             Boolean                         @default(false)
  priceToman         Int?
  monetizationStatus ProviderStoryMonetizationStatus @default(FREE)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  rejectionReason    String?                         @db.Text
  expiresAt          DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  providerProfile ProviderProfile            @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  specialty       Specialty?                 @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  reviewedByAdmin User?                      @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  views           ProviderStoryView[]
  approvalLogs    ProviderStoryApprovalLog[]
  stats           ProviderStoryStat?
  payments        ProviderStoryPayment[]
  conversations   ProviderStoryConversation[]

  @@index([providerProfileId, status, createdAt])
  @@index([specialtyId])
  @@index([status, expiresAt, createdAt])
  @@index([createdAt])
}

model ProviderStoryConversation {
  id                String   @id @default(uuid())
  storyId           String
  customerUserId    String
  providerProfileId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  story           ProviderStory        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  customer        User                 @relation("ProviderStoryCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile      @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  messages        ProviderStoryMessage[]

  @@unique([storyId, customerUserId])
  @@index([providerProfileId, updatedAt])
  @@index([customerUserId, updatedAt])
}

model ProviderStoryMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation ProviderStoryConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                      @relation("ProviderStoryMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model ProviderStoryView {
  id           String   @id @default(uuid())
  storyId      String
  viewerUserId String?
  viewerType   String // CUSTOMER, ADMIN, GUEST
  ipAddress    String?
  viewedAt     DateTime @default(now())

  story ProviderStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, viewedAt])
  @@index([viewerUserId, viewedAt])
}

model ProviderStoryApprovalLog {
  id        String                      @id @default(uuid())
  storyId   String
  adminId   String
  action    ProviderStoryApprovalAction
  comment   String?                     @db.Text
  createdAt DateTime                    @default(now())

  story ProviderStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  admin User          @relation("ProviderStoryApprovalLogs", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([storyId, createdAt])
  @@index([adminId, createdAt])
}

model ProviderStoryStat {
  storyId       String   @id
  viewsCount    Int      @default(0)
  uniqueViewers Int      @default(0)
  lastUpdatedAt DateTime @default(now())

  story ProviderStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
}

model ProviderStoryPayment {
  id                  String    @id @default(uuid())
  storyId             String?   @unique
  storyTitle          String
  providerProfileId   String?
  priceToman          Int
  paidByAdminId       String?
  paidByUserId        String?
  walletTransactionId String?   @unique
  status              String    @default("PENDING") // PENDING, PAID, REJECTED
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  story             ProviderStory?     @relation(fields: [storyId], references: [id], onDelete: SetNull)
  paidByAdmin       User?              @relation("ProviderStoryPaymentApprovals", fields: [paidByAdminId], references: [id], onDelete: SetNull)
  providerProfile   ProviderProfile?   @relation("ProviderStoryProfilePayments", fields: [providerProfileId], references: [id], onDelete: SetNull)
  paidByUser        User?              @relation("ProviderStoryPayments", fields: [paidByUserId], references: [id], onDelete: SetNull)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([storyId, createdAt])
  @@index([status, createdAt])
}
