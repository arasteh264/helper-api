generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  phone            String    @unique
  passwordHash     String?
  googleId         String?   @unique
  role             UserRole
  status           UserStatus
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  otpCode          String?
  otpExpiresAt     DateTime?
  providerProfile ProviderProfile?
}

model ProviderProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  bio            String?
  rating         Float    @default(0)
  isVerified     Boolean  @default(false)
  avatarUrl      String?
  avatarPublicId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id])
  skills ProviderSkill[]
  wallet      Wallet?              
  bankAccount ProviderBankAccount?
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  providers       ProviderSkill[]
  serviceRequests ServiceRequestSkill[]
}

model ProviderSkill {
  providerProfileId String
  skillId           String

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id])
  skill           Skill           @relation(fields: [skillId], references: [id])

  @@id([providerProfileId, skillId])
}

enum ServiceRequestStatus {
  OPEN
  OFFER_ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum PreferredTime {
  URGENT
  THIS_WEEK
  FLEXIBLE
}

model ServiceRequest {
  id            String               @id @default(uuid())
  customerId    String
  title         String
  description   String
  status        ServiceRequestStatus @default(OPEN)

  address       String?
  latitude      Float?
  longitude     Float?

  budgetMin     Float?
  budgetMax     Float?
  preferredTime PreferredTime?

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  skills        ServiceRequestSkill[]
  images        ServiceRequestImage[]
}

model ServiceRequestSkill {
  serviceRequestId String
  skillId          String

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  skill          Skill          @relation(fields: [skillId], references: [id])

  @@id([serviceRequestId, skillId])
}

model ServiceRequestImage {
  id               String   @id @default(uuid())
  serviceRequestId String
  url              String
  publicId         String
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
}

enum WalletTransactionType {
  EARNING          // واریز بابت کار انجام‌شده
  PAYOUT_REQUEST   // کسر موجودی بابت درخواست برداشت
  PAYOUT_REFUND    // برگشت پول درخواست رد یا لغو شده
  ADJUSTMENT       // اصلاح دستی توسط ادمین
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
}



model Wallet {
  id                String   @id @default(uuid())
  providerProfileId String   @unique
  balance           Int      @default(0) // موجودی قابل برداشت
  totalEarned       Int      @default(0)
  totalWithdrawn    Int      @default(0) // مجموع برداشت‌های PAID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  providerProfile ProviderProfile     @relation(fields: [providerProfileId], references: [id])
  transactions    WalletTransaction[]
  payouts         PayoutRequest[]
}

model WalletTransaction {
  id               String                @id @default(uuid())
  walletId         String
  type             WalletTransactionType
  amount           Int                   // مثبت = واریز، منفی = برداشت
  balanceAfter     Int
  description      String?
  serviceRequestId String?
  payoutRequestId  String?
  createdAt        DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  // جلوگیری از واریز دوباره برای یک کار (NULLها در Postgres با هم تداخل ندارن)
  @@unique([walletId, type, serviceRequestId])
  @@index([walletId, createdAt])
}

model ProviderBankAccount {
  id                String   @id @default(uuid())
  providerProfileId String   @unique
  holderName        String
  sheba             String
  bankName          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id])
}

model PayoutRequest {
  id            String       @id @default(uuid())
  walletId      String
  amount        Int
  status        PayoutStatus @default(PENDING)

  // کپی حساب بانکی در لحظه درخواست، تا تغییر بعدی حساب روی درخواست‌های قدیمی اثر نذاره
  holderName    String
  sheba         String
  bankName      String?

  referenceCode String?      // کد پیگیری واریز (توسط ادمین)
  rejectReason  String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([status, createdAt])
}